# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=your_groq_model_name_here

# Databases
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/ragdb
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# Models
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Ingestion
MAX_UPLOAD_MB=10
ENABLE_OCR=false
UPLOAD_DIR=storage/uploads

# Chunking defaults
RECURSIVE_CHUNK_SIZE=1000
RECURSIVE_CHUNK_OVERLAP=150
SEMANTIC_MAX_CHARS=1000
SEMANTIC_MIN_CHARS=200
SEMANTIC_BREAK_PERCENTILE=25

# Retrieval
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANK_TOP_K=20
FINAL_TOP_K=5
RELEVANCE_THRESHOLD=0.3

# Memory
HISTORY_MESSAGES_IN_PROMPT=6
HISTORY_MESSAGES_STORED=20
CHAT_TTL_SECONDS=86400
BOOKING_TTL_SECONDS=3600

# Security (leave empty to disable the X-API-Key check)
API_KEY=

# Booking
TIMEZONE=Asia/Kathmandu